{
  "name": "clicker-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:demo": "node --experimental-strip-types scripts/prepare-demo.ts",
    "predev": "npm run prepare:demo",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run prepare:demo",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "lucide-react": "1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
